# Conexão com o Neon (pooled) usada pela aplicação
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
# Conexão direta, usada só pelo Prisma para criar/alterar tabelas
DIRECT_URL="postgresql://USUARIO:SENHA@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"
# Senha única de acesso da equipe
ACESSO_SENHA="troque-esta-senha"
# Segredo para assinar a sessão (32+ caracteres aleatórios)
SESSAO_SEGREDO="gere-um-valor-aleatorio"
# Senha de quem atualiza os dados pela tela Atualizar (diferente da senha da equipe)
IMPORTACAO_SENHA="troque-esta-senha-de-importacao"
